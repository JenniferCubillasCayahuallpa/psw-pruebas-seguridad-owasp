# Copia este archivo como .env y ajusta los valores antes de usar el proyecto.
# Nunca subas el .env real al repositorio.

FLASK_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-32-bytes
JWT_SECRET=cambia-este-secreto-por-otro-diferente-y-aleatorio

# 0 = modo seguro (recomendado / producción)
# 1 = modo laboratorio: expone endpoints vulnerables A PROPÓSITO para las prácticas
LAB_MODE=0

# 1 = cookies Secure (solo con HTTPS). En localhost déjalo en 0.
COOKIE_SECURE=0

DATABASE_URL=sqlite:///instance/psw_seguridad.db
PORTAL_URL=http://127.0.0.1:5000

# Opcional: para el script scripts/zap_baseline.py
ZAP_URL=http://127.0.0.1:8090
ZAP_API_KEY=
